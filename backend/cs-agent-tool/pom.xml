<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.csagent</groupId>
        <artifactId>cs-agent-backend</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>cs-agent-tool</artifactId>
    <name>cs-agent-tool</name>
    <description>Tool Calling 框架：工具定义、注册、执行</description>

    <dependencies>
        <dependency>
            <groupId>com.csagent</groupId>
            <artifactId>cs-agent-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-client-chat</artifactId>
        </dependency>
        <!-- 已移除 com.fasterxml.jackson.core:jackson-databind（Jackson 2）。
             Spring Boot 4 内部用的是 Jackson 3（tools.jackson），业务代码也统一到 3.x；
             2.x 只作为 jjwt-jackson 的传递依赖存在，不再显式声明。
             本模块没有任何类 import Jackson，声明它是历史遗留。 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
