<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.csagent</groupId>
        <artifactId>cs-agent-backend</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>cs-agent-rag</artifactId>
    <name>cs-agent-rag</name>
    <description>RAG 知识库模块：文档解析、分块、Embedding、向量检索、检索增强</description>

    <dependencies>
        <dependency>
            <groupId>com.csagent</groupId>
            <artifactId>cs-agent-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.csagent</groupId>
            <artifactId>cs-agent-llm</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
            <version>${tika.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parsers-standard-package</artifactId>
            <version>${tika.version}</version>
        </dependency>
        <!-- 向量库当前用本地 SimpleMemoryVectorStore，未使用 Redis。
             残留的 spring-boot-starter-data-redis 会让 actuator 自动装配 RedisHealthIndicator，
             本地未启动 Redis 时 /actuator/health 被判定为 DOWN（HTTP 503）。
             将来要接 Redis Stack 做向量库，再加回 starter 并配置 spring.data.redis.* 即可。 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 知识库持久化：文档元数据与向量块需要落库，否则重启后客户上传的资料全部丢失。
             只在 cs-agent.rag.storage=jdbc 时启用 JPA 实现，默认仍是内存实现（零依赖可跑）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- 测试依赖：知识库租户隔离是数据泄露级红线（AGENTS.md §8.1⑦ 第 4 条），
             必须有自动化测试证明"B 租户看不到 A 租户的文档"，不能只靠人工点一遍 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
